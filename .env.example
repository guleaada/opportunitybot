# ═══════════════════════════════════════════════════════════════
# OpportunityBot configuration — copy to `.env` and fill in.
# ═══════════════════════════════════════════════════════════════

# === HIGH-STAKES MODEL (paid) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# === FREE MODEL #1 — medium tasks ===
GEMINI_API_KEY=                       # Get at aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash

# === FREE MODEL #2 — mechanical tasks ===
GROQ_API_KEY=                         # Get at console.groq.com
OPENROUTER_API_KEY=                   # Get at openrouter.ai/keys (optional backup)
OPENROUTER_MODEL=openrouter/free      # Auto-router; survives free-model rotation
MISTRAL_API_KEY=                      # console.mistral.ai (free tier; optional)
MISTRAL_MODEL=mistral-small-latest    # MUST be a model your free tier includes
MISTRAL_REQUESTS_PER_MINUTE=10        # conservative; override with real limits
MISTRAL_REQUESTS_PER_DAY=500
MODEL_PROVIDER_ORDER=groq,openrouter,mistral,gemini   # claude omitted = $0
GROQ_MODEL=                           # REQUIRED. No default — Groq retires
                                      # model ids (llama-3.3-70b-versatile
                                      # was decommissioned 2026-08-16).
                                      # Use a current id from console.groq.com.

# === FALLBACK (cheap paid) ===
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# === EMAIL ===
EMAIL_FROM=gulilatkasiye4@gmail.com
EMAIL_APP_PASSWORD=                   # myaccount.google.com/apppasswords
EMAIL_TO=gulilatkasiye4@gmail.com

# === WEB SEARCH ===
# Tavily is used whenever TAVILY_API_KEY is set; Google CSE is the fallback.
TAVILY_API_KEY=                       # app.tavily.com
TAVILY_REQUESTS_PER_MINUTE=10         # local throttle, NOT a published Tavily
TAVILY_REQUESTS_PER_DAY=100           # limit — Tavily meters by credits
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# === PAGE FETCHING ===
# r.jina.ai reader proxy, used whenever a source 403s the direct fetch.
# Keyless works locally, but is metered 20 RPM PER IP — from CI, where runner
# IPs are shared, keyless calls get 429'd and the whole fallback tier dies
# silently. A free key (jina.ai) is metered per key at 500 RPM. Strongly
# recommended: without it, blocked pages degrade to feed snippets that the
# legitimacy and eligibility gates cannot clear, and nothing gets notified.
JINA_API_KEY=                         # jina.ai — free tier

# Whitelisted-source quality (1-10) at or above which a snippet-only candidate
# is passed through flagged UNVERIFIED rather than silently dropped.
# 11 restores the previous always-drop behaviour.
TRUST_WHITELIST_MIN_QUALITY=7

# === OPTIONAL ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json

# === COST GUARDRAILS ===
DAILY_CLAUDE_BUDGET_USD=0.50          # Hard cap; bot downgrades to Gemini if exceeded
MONTHLY_CLAUDE_BUDGET_USD=10.00       # Monthly cap
MIN_SCORE_TO_NOTIFY=7
MAX_OPPORTUNITIES_PER_DAY=15
DAILY_SCAN_TIME=08:00
