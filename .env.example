# ═══════════════════════════════════════════════════════════════
# OpportunityBot configuration — copy to `.env` and fill in.
# ═══════════════════════════════════════════════════════════════

# === HIGH-STAKES MODEL (paid) ===
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# === FREE MODEL #1 — medium tasks ===
GEMINI_API_KEY=                       # Get at aistudio.google.com/app/apikey
GEMINI_MODEL=gemini-2.5-flash

# === FREE MODEL #2 — mechanical tasks ===
GROQ_API_KEY=                         # Get at console.groq.com
OPENROUTER_API_KEY=                   # Get at openrouter.ai/keys (optional backup)
OPENROUTER_MODEL=openrouter/free      # Auto-router; survives free-model rotation
GROQ_MODEL=llama-3.3-70b-versatile

# === FALLBACK (cheap paid) ===
ANTHROPIC_FALLBACK_MODEL=claude-haiku-4-5

# === EMAIL ===
EMAIL_FROM=gulilatkasiye4@gmail.com
EMAIL_APP_PASSWORD=                   # myaccount.google.com/apppasswords
EMAIL_TO=gulilatkasiye4@gmail.com

# === WEB SEARCH ===
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# === OPTIONAL ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials.json

# === COST GUARDRAILS ===
DAILY_CLAUDE_BUDGET_USD=0.50          # Hard cap; bot downgrades to Gemini if exceeded
MONTHLY_CLAUDE_BUDGET_USD=10.00       # Monthly cap
MIN_SCORE_TO_NOTIFY=7
MAX_OPPORTUNITIES_PER_DAY=15
DAILY_SCAN_TIME=08:00
